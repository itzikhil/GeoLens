# ─── Supabase (required) ───────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# ─── Edge Function Secrets (set via Supabase dashboard or CLI) ─────────────
# These are NOT used in the frontend — they are configured as Supabase secrets
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# LOVABLE_API_KEY=your_lovable_ai_gateway_key
# NEWS_API_KEY=your_newsapi_key (optional — enables News API handler)
# YOUTUBE_API_KEY=your_youtube_data_api_key (optional — enables YouTube handler)
# X_BEARER_TOKEN=your_x_bearer_token (optional — enables X/Twitter handler)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token (optional — enables Telegram handler)
